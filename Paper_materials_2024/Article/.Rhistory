View(df_migr_mtdna)
View(df_migr)
df_migr$Species = gsub(' ', '_', df_migr$Species)
df_migr_mtdna = merge(df_short, df_migr, by = 'Species')
View(df_migr_mtdna)
rm(list = ls(all=TRUE))
