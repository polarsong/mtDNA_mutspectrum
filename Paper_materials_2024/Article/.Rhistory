new_big_exp = new_big[new_big$Pro_PheLeu != 'Inf',]
new_big_exp$trand = 1
new_big_exp[new_big_exp$gene_name == 'ND6',]$trand = 0
TBSS_ppl = lm(Pro_PheLeu ~ scale(classbinar) + scale(trand), data = new_big_exp)
summary(TBSS_ppl)
