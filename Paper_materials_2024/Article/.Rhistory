df_divegls = df_divegls[df_divegls$flightless != 'Galliformes',]
df_divegls[df_divegls$flightless == '0',]$flightless = 'Flying birds'
df_divegls$abtf = 1
df_divegls[df_divegls$flightless != 'Flying birds',]$abtf = 0
