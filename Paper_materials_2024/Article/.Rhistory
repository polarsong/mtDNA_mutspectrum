}
View(spearman_rhos_ghahskew)
tbss_sampl = sample(tbss, 10, replace = TRUE)
spearman_rhos_ghahskew_sample = data.frame()
spearman_rhos_ghahskew_sample = data.frame()
for (i in b_names)
{
