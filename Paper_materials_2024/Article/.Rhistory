col2 = df_nd6[df_nd6$gene_name == 'CYTB',]
wilcox.test(col1$GhAhSkew,col2$GhAhSkew)
wilcox.test(col1$ThChSkew, col2$ThChSkew)
col1 = df_nd6[df_nd6$gene_name == 'ND1',]
col2 = df_nd6[df_nd6$gene_name == 'ND2',]
