spp = rownames(df_long_pgls)
pgls_long = gls(GhAhSkew~Longevity,
data=df_long_pgls,correlation=corLambda)
spp = rownames(df_long_pgls)
corLambda<-corPagel(value=1,phy=Long_skew_tree,form=~spp)
