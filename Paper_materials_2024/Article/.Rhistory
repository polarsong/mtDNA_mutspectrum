for (i in names_v)
{
df1 = df_bmr_e[df_bmr_e$Species == i,]
a1 = sum(df1$TraitValue)
a2 = nrow(df1)
a = a1/a2
b = 'BMR'
ab = c(i, b, a)
df_short_1 = rbind(df_short_1, ab)
}
names(df_short_1) = c('Species', 'Trait', 'BMR_value')
