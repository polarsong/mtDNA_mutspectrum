df_tg[df_tg$Mut == 'T>G',]$Mut = 'A>C'
df_mut_cor = rbind(df_ac, df_ag, df_at, df_ca, df_cg, df_ct, df_ga, df_gc, df_gt, df_ta, df_tc, df_ag)
df_mut_aves = df_mut_cor[df_mut_cor$Class == 'Aves',]
